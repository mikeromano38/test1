    "examples": "tsx src/cli.ts examples",
    "gallery": "tsx src/cli.ts gallery",
    "serve": "tsx scripts/serve.ts",
    "extract": "tsx scripts/extract_thelook.ts",
    "synth": "tsx scripts/synth_snapshot.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
